#. module: nexa_warning_letter
#: model:mail.template,body_html:nexa_warning_letter.nexa_mail_template_warning_issued
msgid ""
"<div style=\"margin:0;padding:0;background:#f4f5f7;\">\n"
"  <div style=\"max-width:600px;margin:0 auto;padding:16px;font-family:Arial,Helvetica,sans-serif;color:#374151;\">\n"
"    <div style=\"background:#9f1d1d;color:#ffffff;padding:16px 20px;border-radius:12px 12px 0 0;\">\n"
"      <div style=\"font-size:12px;letter-spacing:.06em;text-transform:uppercase;opacity:.85;\">Warning Letter</div>\n"
"      <div style=\"font-size:20px;font-weight:bold;\"><t t-out=\"object.type_id.name or ''\"/></div>\n"
"    </div>\n"
"    <div style=\"background:#ffffff;padding:20px;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 12px 12px;\">\n"
"      <p style=\"margin:0 0 12px;\">Dear <b><t t-out=\"object.employee_name or ''\"/></b>,</p>\n"
"      <p style=\"margin:0 0 16px;\">\n"
"        You have received a <b><t t-out=\"object.type_id.name or ''\"/></b> with the following details:\n"
"      </p>\n"
"      <table style=\"width:100%;border-collapse:collapse;font-size:14px;\">\n"
"        <tr>\n"
"          <td style=\"padding:6px 0;color:#6b7280;width:170px;\">Number</td>\n"
"          <td style=\"padding:6px 0;\"><t t-out=\"object.name or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"          <td style=\"padding:6px 0;color:#6b7280;\">Type</td>\n"
"          <td style=\"padding:6px 0;\"><t t-out=\"object.type_id.name or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"          <td style=\"padding:6px 0;color:#6b7280;\">Validity</td>\n"
"          <td style=\"padding:6px 0;\">\n"
"            <t t-out=\"format_date(object.effective_date)\"/> - <t t-out=\"format_date(object.end_date)\"/>\n"
"          </td>\n"
"        </tr>\n"
"        <tr t-if=\"object.department_id\">\n"
"          <td style=\"padding:6px 0;color:#6b7280;\">Department</td>\n"
"          <td style=\"padding:6px 0;\"><t t-out=\"object.department_id.name or ''\"/></td>\n"
"        </tr>\n"
"      </table>\n"
"      <p t-if=\"object.notes\" style=\"margin:16px 0 0;white-space:pre-line;\"><t t-out=\"object.notes\"/></p>\n"
"      <p style=\"margin:16px 0 0;\">\n"
"        Please take this as a point of attention for the future. For any question, contact HR or\n"
"        your manager.\n"
"      </p>\n"
"      <div style=\"margin:20px 0 0;\">\n"
"        <a t-att-href=\"object._nex_record_url()\" style=\"background:#9f1d1d;color:#ffffff;padding:10px 18px;border-radius:6px;text-decoration:none;font-size:14px;display:inline-block;\">\n"
"          Read the warning letter\n"
"        </a>\n"
"      </div>\n"
"      <p style=\"margin:16px 0 0;color:#9ca3af;font-size:12px;border-top:1px solid #f0f1f3;padding-top:12px;\">\n"
"        Automatic e-mail from <t t-out=\"object.company_id.name or ''\"/>. Please do not reply.\n"
"        <t t-if=\"object.company_id.nex_warning_cc_watchers and object.watcher_ids\">The appointed watchers receive a copy.</t>\n"
"      </p>\n"
"    </div>\n"
"  </div>\n"
"</div>\n"
"            "
msgstr ""

